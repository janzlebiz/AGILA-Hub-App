# AGILA Hub Environment & Secrets Configuration Template
# DO NOT store real production secrets or private keys in this file.

# PUBLIC CLIENT CONFIGURATION (Bundled into Android app / browser)
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_ANON_KEY

# SERVER-ONLY CONFIGURATION (Vercel / Edge Functions / Secret Manager ONLY)
# NEVER expose or bundle these variables into Android APK or browser code!
# SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_PLACEHOLDER
# AI_PROVIDER_API_KEY=SERVER_ONLY_PLACEHOLDER

# GEMINI_API_KEY: Injected by AI Studio runtime secrets panel
# GEMINI_API_KEY=MY_GEMINI_API_KEY
